{
  "version": "1.0",
  "note": "HKIA 指标目录。每项含 unit/layer/scope/period_basis/certification/schema/comparability/release。目录缺项时查询失败，不临时猜测。",
  "metrics": {
    "NB_IND_TOTAL_SINGLE_PREMIUM": {
      "label": "个人新造整付保费",
      "source_layer": "standard",
      "source_table": "market_facts",
      "source_filter_column": "metric_id",
      "unit": "HKD_thousand",
      "entity_scope": "market_total",
      "period_basis": "quarterly_ytd",
      "certification_rule": "provisional (季度/年度临时)",
      "schema": "lt_qr_quarterly",
      "supported_query_types": ["market_trend", "describe_metric"],
      "comparable_with": ["2023Q1,2024Q1,2025Q1,2026Q1 季度序列"],
      "prohibited_comparisons": ["跨schema分类明细", "count"],
      "aggregation": "flow",
      "source_definition": "IA 长期业务季度临时统计 Table L1 市场总额 个人新造整付保费",
      "release_policy_id": "internal_review_only"
    },
    "NB_IND_TOTAL_ANNUALIZED_PREMIUM": {
      "label": "个人新造年度化保费",
      "source_layer": "standard",
      "source_table": "market_facts",
      "source_filter_column": "metric_id",
      "unit": "HKD_thousand",
      "entity_scope": "market_total",
      "period_basis": "quarterly_ytd",
      "certification_rule": "provisional",
      "schema": "lt_qr_quarterly",
      "supported_query_types": ["market_trend", "describe_metric"],
      "comparable_with": ["季度序列"],
      "prohibited_comparisons": ["count", "含年金L1 vs 不含年金L16"],
      "aggregation": "flow",
      "source_definition": "IA 长期业务季度临时统计 Table L1 个人新造年度化保费 市场总额",
      "release_policy_id": "internal_review_only"
    },
    "NB_GROUP_POLICIES": {
      "label": "团体新造保单数",
      "source_layer": "standard",
      "source_table": "market_facts",
      "unit": "count",
      "entity_scope": "market_total",
      "period_basis": "quarterly_ytd",
      "certification_rule": "provisional",
      "schema": "lt_qr_quarterly",
      "supported_query_types": ["market_trend", "describe_metric"],
      "prohibited_comparisons": ["金额转换"],
      "aggregation": "flow"
    },
    "IF_IND_TOTAL_POLICIES": {
      "label": "个人有效保单数",
      "source_layer": "standard",
      "source_table": "market_facts",
      "unit": "count",
      "entity_scope": "market_total",
      "period_basis": "quarterly_ytd",
      "certification_rule": "provisional",
      "schema": "lt_qr_quarterly",
      "supported_query_types": ["market_trend", "describe_metric"],
      "prohibited_comparisons": ["金额转换"],
      "aggregation": "stock"
    },
    "ANNUAL_L16_PREMIUM_SINGLE": {
      "label": "年度个人寿险新造整付保费",
      "source_layer": "annual",
      "source_table": "company_facts",
      "source_filter": {"table_id": "L16", "metric_sem": "premium_single", "entity_scope": "insurer"},
      "unit": "HKD_thousand",
      "entity_scope": "insurer",
      "period_basis": "annual_certified",
      "certification_rule": "certified (年度层, 2022-2024)",
      "schema": "annual_lt",
      "supported_query_types": ["company_ranking", "company_period_values", "compare_periods"],
      "comparable_with": ["同 schema 年度 certified 公司比较"],
      "prohibited_comparisons": ["与2025 L1(个人长期含年金)直接比"],
      "aggregation": "flow",
      "source_definition": "IA 年度长期业务 Table L16 个人寿险新造整付保费(不含年金) 公司级",
      "release_policy_id": "annual_certified_internal"
    },
    "ANNUAL_L16_PREMIUM_ANNUAL": {
      "label": "年度个人寿险新造年度化保费",
      "source_layer": "annual",
      "source_table": "company_facts",
      "source_filter": {"table_id": "L16", "metric_sem": "premium_annual", "entity_scope": "insurer"},
      "unit": "HKD_thousand",
      "entity_scope": "insurer",
      "period_basis": "annual_certified",
      "certification_rule": "certified",
      "schema": "annual_lt",
      "supported_query_types": ["company_ranking", "company_period_values", "compare_periods"],
      "prohibited_comparisons": ["与2025 L1直接比"],
      "aggregation": "flow"
    },
    "PROV2025_NB_TOTAL_SINGLE": {
      "label": "2025 个人长期新造整付保费(含年金混入, 不可比L16)",
      "source_layer": "provisional2025",
      "source_table": "provisional_company_facts",
      "source_filter": {"metric_sem": "nb_total_single_premium", "entity_scope": "insurer"},
      "unit": "HKD_thousand",
      "entity_scope": "insurer",
      "period_basis": "annual_provisional",
      "certification_rule": "provisional",
      "schema": "lt_qr_2025",
      "supported_query_types": ["company_ranking", "company_period_values"],
      "prohibited_comparisons": ["与2024 L16直接算增长"],
      "aggregation": "flow"
    },
    "PROV2025_NB_TOTAL_ANNUAL": {
      "label": "2025 个人长期新造年度化保费",
      "source_layer": "provisional2025",
      "source_table": "provisional_company_facts",
      "source_filter": {"metric_sem": "nb_total_annualized_premium", "entity_scope": "insurer"},
      "unit": "HKD_thousand",
      "entity_scope": "insurer",
      "period_basis": "annual_provisional",
      "certification_rule": "provisional",
      "schema": "lt_qr_2025",
      "supported_query_types": ["company_ranking", "company_period_values"],
      "prohibited_comparisons": ["与2024直接比"],
      "aggregation": "flow"
    },
    "FIN_DEBT_SECURITIES": {
      "label": "债务证券(行业财务)",
      "source_layer": "financial",
      "source_table": "financial_facts",
      "unit": "HKD_million",
      "entity_scope": "fund",
      "period_basis": "quarterly_snapshot",
      "certification_rule": "provisional",
      "schema": "financial",
      "supported_query_types": ["financial_snapshot", "describe_metric"],
      "prohibited_comparisons": ["count"],
      "aggregation": "stock"
    }
  }
}

{
  "_说明": "复制为 wps_sources.json 后按实际文档填写。file_id 用 `python3 wps_sync.py resolve <分享链接>` 解析得到，不要直接填分享链接里 /l/ 后面的 link_id。",
  "sources": [
    {
      "alias": "示例_多维表格",
      "kind": "dbsheet",
      "file_id": "填resolve出来的file_id",
      "sheets": [],
      "note": "sheets 留空=同步该文件下全部数据表；填数据表ID或名称=只同步这几张"
    },
    {
      "alias": "示例_传统表格",
      "kind": "sheets",
      "file_id": "填resolve出来的file_id",
      "worksheets": [],
      "range": { "row_from": 0, "row_to": 999, "col_from": 0, "col_to": 49 },
      "note": "range 是读取选区，表大就调大 row_to/col_to；留空用默认 1000行×50列"
    },
    {
      "alias": "示例_智能表格",
      "kind": "airsheet",
      "file_id": "填resolve出来的file_id",
      "worksheets": [],
      "range": { "row_from": 0, "row_to": 999, "col_from": 0, "col_to": 49 },
      "note": "文件后缀必须是 .ksheet"
    },
    {
      "alias": "示例_文字文档",
      "kind": "file",
      "file_id": "填resolve出来的file_id",
      "note": "文字文档无读正文的服务端接口，本项只跟踪元信息（名称/修改时间），用于发现它被改过"
    }
  ]
}

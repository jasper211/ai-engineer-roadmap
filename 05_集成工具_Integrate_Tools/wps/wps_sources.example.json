{
  "_说明": "推荐用 folder 源：给一个文件夹（或整个盘），自动递归发现里面所有表格，不用逐个填文件。先跑 `python3 wps_sync.py tree` 看目录树，再照着写。",

  "sources": [
    {
      "alias": "全部团队盘",
      "kind": "folder",
      "drive_id": "all",
      "folder_id": "0",
      "max_depth": 8,
      "kinds": ["dbsheet", "sheets", "airsheet"],
      "note": "drive_id填all=遍历所有团队盘；folder_id填0=从盘根目录开始。kinds限定只同步这几类，不写默认就是这三类表格"
    },
    {
      "alias": "某个文件夹",
      "kind": "folder",
      "drive_id": "填tree命令列出的drive_id",
      "folder_id": "填该文件夹的id",
      "range": { "row_from": 0, "row_to": 1999, "col_from": 0, "col_to": 59 },
      "note": "range 只对传统/智能表格生效，会应用到该文件夹下所有此类表；表很大就调大"
    },

    {
      "alias": "示例_单个多维表格",
      "kind": "dbsheet",
      "file_id": "用 resolve <分享链接> 解析得到",
      "sheets": [],
      "note": "只想同步个别文件时用。sheets留空=该文件下全部数据表"
    },
    {
      "alias": "示例_单个传统表格",
      "kind": "sheets",
      "file_id": "用 resolve <分享链接> 解析得到",
      "worksheets": [],
      "range": { "row_from": 0, "row_to": 999, "col_from": 0, "col_to": 49 }
    },
    {
      "alias": "示例_单个智能表格",
      "kind": "airsheet",
      "file_id": "用 resolve <分享链接> 解析得到",
      "worksheets": [],
      "range": { "row_from": 0, "row_to": 999, "col_from": 0, "col_to": 49 },
      "note": "文件后缀必须是 .ksheet"
    },
    {
      "alias": "示例_文字文档",
      "kind": "file",
      "file_id": "用 resolve <分享链接> 解析得到",
      "note": "文字文档无读正文接口，只跟踪元信息（改没改、什么时候改的）"
    }
  ]
}

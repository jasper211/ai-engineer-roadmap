<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jasper.pta-multi-daily-scan</string>

    <!-- 取代原来"一个项目一个plist"的模式（原 com.jasper.pta-daily-scan.plist
         仍保留，单项目场景可以继续用它）——协同项目从 EA/Rw 扩展到还要加
         Jasper工作文档、以后还会继续加，改成一个 job 触发
         multi_project_daily_scan.py，项目清单在 daily_scan_projects.json 里维护，
         加新项目不需要再装新 plist。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <!-- ⚠️ 装的时候用 `which python3` 确认这个路径对不对（Intel Mac 通常是
             /usr/local/bin/python3），launchd 不读 shell profile。 -->
        <string>REPLACE_WITH_MULTI_PROJECT_DAILY_SCAN_PY_ABSOLUTE_PATH</string>
        <!-- 例：/Users/xxx/.../05_Agent库/草稿/PTA/10_部署与运行_Deploy_and_Run/multi_project_daily_scan.py -->
        <string>--notify</string>
    </array>

    <!-- 2026-07-28 Jasper定：改成对齐北京时间周一至周五11:00，不是本机所在
         时区(America/Chicago)的11:00——launchd的StartCalendarInterval只认
         本地挂钟时间，不支持跨时区调度，所以这里用当前芝加哥与北京的真实
         时差（CDT期间13小时）反推出本地触发时刻：北京周一~周五11:00，
         分别对应芝加哥本地的周日~周四22:00（提前了一整个日期）。
         Jasper已确认接受的取舍：每年11月/3月美国夏令时切换时，芝加哥与
         北京的时差会在13/14小时之间变化，届时这份定时会对应北京时间12:00
         而不是11:00，需要人工把Hour从22改成21（或反过来）——不做成自动
         感知时区的包装脚本，简单换算+每半年手动微调一次是Jasper明确选择
         的方案，见执行记录.md。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>0</integer>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/pta-multi-daily-scan.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pta-multi-daily-scan.err</string>

    <!-- ⚠️⚠️⚠️ 真实的 DEEPSEEK_API_KEY 绝不能填在这份文件里！这份文件在
         git 仓库里会被追踪、可能推到远程。按 INSTALL_DAILY_SCAN.md 的说明，
         把这个占位符复制到 ~/Library/LaunchAgents/ 之后，只在那份【不受 git
         追踪】的副本里填真实 key。
         PTA_WORKSPACE_ROOT 不是必填——workspace.py 的兜底默认值已经改成按
         Path.home() 动态推导，这台机器不设置也能正确落在
         ~/Desktop/Jasper工作文档（不含EA项目）/项目工作区/；只有想换到别的
         位置时才需要显式设置。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>DEEPSEEK_API_KEY</key>
        <string>REPLACE_WITH_YOUR_REAL_KEY_ONLY_IN_THE_INSTALLED_COPY</string>
    </dict>
</dict>
</plist>

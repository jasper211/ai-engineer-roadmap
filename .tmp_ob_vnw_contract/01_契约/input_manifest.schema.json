{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasper.local/ob-vnw/input_manifest.schema.json",
  "title": "OB向VNW发布的知识输入清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "publisher", "published_at", "ob_root_path", "sources"],
  "properties": {
    "schema_version": {"const": "ob-vnw.input-manifest.v1"},
    "release_id": {"type": "string", "pattern": "^OB-[0-9]{8}-[0-9]{3,}$"},
    "publisher": {"const": "OB_AGENT"},
    "published_at": {"type": "string", "format": "date-time"},
    "ob_root_path": {"type": "string", "minLength": 1},
    "release_note": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "relative_path", "title", "sha256", "mtime", "size_bytes", "version", "l3_codes", "l4_codes", "knowledge_types", "lifecycle_status", "evidence_level", "mapping_basis", "locators"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^OB-EA-[A-Z0-9][A-Z0-9._-]*$"},
        "relative_path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
        "title": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mtime": {"type": "string", "format": "date-time"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1},
        "l3_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L3-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
        "l4_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L4-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]+$"}},
        "knowledge_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PROCESS_BLUEPRINT", "L4_DELIVERY", "D1_D6_ASSESSMENT", "SOP", "BUSINESS_RULE", "ORG_ROLE", "TASK_DECOMPOSITION", "AI_FEASIBILITY", "KPI_QUALITY", "VALUE_NODE_MAPPING", "L2_CAPABILITY", "METHODOLOGY", "AGENT_DESIGN", "DATA_MAPPING"]}},
        "lifecycle_status": {"enum": ["DRAFT", "UNDER_REVIEW", "CONFIRMED", "DEPRECATED"]},
        "evidence_level": {"enum": ["PRIMARY_SSOT", "CORROBORATING", "CONTEXT_ONLY"]},
        "mapping_basis": {"enum": ["EXPLICIT_IN_CONTENT", "STRUCTURED_FIELD", "MANUAL_CONFIRMED"]},
        "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"lifecycle_status": {"const": "CONFIRMED"}}}, "then": {"anyOf": [{"properties": {"l3_codes": {"minItems": 1}}}, {"properties": {"knowledge_types": {"contains": {"enum": ["METHODOLOGY", "DATA_MAPPING"]}}}}]}}
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_type", "value"],
      "properties": {
        "locator_type": {"enum": ["WHOLE_FILE", "MD_SECTION", "LINE_RANGE", "CSV_ROW_RANGE", "XLSX_RANGE", "JSON_POINTER", "PAGE_RANGE"]},
        "value": {"type": "string", "minLength": 1},
        "sheet": {"type": "string"},
        "l3_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L3-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
        "l4_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L4-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]+$"}}
      }
    }
  }
}
